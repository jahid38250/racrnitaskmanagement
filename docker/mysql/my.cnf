[mysqld]
# Character set and collation (Full Unicode & Bangla support)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Timezone: Bangladesh Standard Time (+06:00)
default-time-zone = '+06:00'

# InnoDB reliability & LAN server tuning
default-storage-engine = InnoDB
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# Allow large JSON payloads, employee attachments metadata, and backup snapshots
max_allowed_packet = 64M
max_connections = 150
wait_timeout = 28800
interactive_timeout = 28800

# Security: Listen only on Docker internal network interfaces (never published on LAN)
bind-address = 0.0.0.0
skip-name-resolve

[client]
default-character-set = utf8mb4
