# =====================================================================
# RAC R&I Task Management System - Environment Configuration Template
# =====================================================================
# Copy this file to .env (or use the generated .env on your Ubuntu server)
# and supply strong unique passwords before starting Docker Compose.

# Server & HTTP Reverse Proxy
SERVER_HOST="0.0.0.0"
HTTP_PORT="80"
PORT="3000"
APP_URL="http://0.0.0.0:80"
TZ="Asia/Dhaka"

# Authentication Secret
JWT_SECRET="replace-with-secure-random-jwt-secret"

# Local MySQL 8 Configuration (Docker Internal Network Only)
MYSQL_HOST="mysql"
MYSQL_PORT="3306"
MYSQL_DATABASE="task_management"
MYSQL_USER="taskadmin"
MYSQL_PASSWORD="replace-with-secure-mysql-password"
MYSQL_ROOT_PASSWORD="replace-with-secure-mysql-root-password"

# Automated MySQL Backup Retention (Days)
BACKUP_RETENTION_DAYS="30"
